# Kopiere diese Datei zu ".env" und trage deine echten Werte ein.
# Die ".env" darf NIEMALS ins Git-Repository kommen (sie steht in .gitignore).

# Garmin Connect Zugangsdaten (nur lokal, nie im Code!)
GARMIN_EMAIL=deine-email@example.com
GARMIN_PASSWORD=dein-garmin-passwort

# Wo die Login-Tokens gespeichert werden (Ordner wird automatisch angelegt, Rechte 600/700)
GARMIN_TOKEN_DIR=./garmin_tokens

# Pfad zur lokalen SQLite-Datenbank
DASHBOARD_DB_PATH=./data/dashboard.db

# Deine Zeitzone (wichtig fuer Schlafzeiten etc.)
TIMEZONE=Europe/Berlin

# Wird erst in Phase 4 gebraucht (Chat-Funktion) - kann vorerst leer bleiben
ANTHROPIC_API_KEY=
